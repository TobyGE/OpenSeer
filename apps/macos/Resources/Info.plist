<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>OpenSeer</string>
    <key>CFBundleExecutable</key>
    <string>OpenSeerGUI</string>
    <key>CFBundleIdentifier</key>
    <string>com.openseer.OpenSeer</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>OpenSeer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.10</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Permission usage strings. Accessibility + Screen Recording
         are requested at runtime by AXIsProcessTrusted /
         CGRequestScreenCaptureAccess; macOS shows these strings in
         the system prompt. -->
    <key>NSAccessibilityUsageDescription</key>
    <string>OpenSeer reads on-screen UI elements (button text, labels) so the agent can decide what to click.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>OpenSeer scripts apps via AppleEvents to switch focus and read window titles.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>OpenSeer listens to your voice so spoken requests can be submitted as normal OpenSeer tasks.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>OpenSeer captures the screen so the agent can understand what you are looking at and operate visible UI.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>OpenSeer uses on-device speech recognition to convert spoken requests into task text.</string>
</dict>
</plist>
